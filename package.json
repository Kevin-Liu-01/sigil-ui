{
  "name": "sigil-ui",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "build": "turbo build",
    "build:runtime-packages": "pnpm --filter @sigil-ui/tokens build && pnpm --filter @sigil-ui/presets build && pnpm --filter @sigil-ui/components build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "audit:contrast": "tsx scripts/audit-contrast.ts",
    "audit:sigil": "node scripts/audit-sigil.mjs",
    "audit:components": "node scripts/audit-components.mjs",
    "audit:presets": "tsx scripts/audit-presets.ts",
    "audit:layout": "node scripts/audit-layout-system.mjs",
    "audit:layout:quick": "node scripts/audit-layout-system.mjs --quick --skip-screenshots",
    "audit:grid": "node scripts/audit-grid-alignment.mjs",
    "audit:authoring": "node scripts/audit-sigil-authoring.mjs",
    "smoke:create-app": "node scripts/smoke-create-sigil-app.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "culori": "^4.0.2",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "turbo": "^2.4.0",
    "typescript": "^5.8.0"
  }
}
